# CardioIA, Fase 3, Ir Alem 1: copie para .env e ajuste. O .env nao e versionado.

# Modo da automacao de e-mail: simulado (padrao, registra em logs/emails_simulados.log),
# local (servidor SMTP de depuracao, ex.: python -m aiosmtpd -n -l localhost:1025) ou smtp (servidor real).
EMAIL_MODO=simulado
EMAIL_REMETENTE=cardioia-alertas@exemplo.local
EMAIL_DESTINATARIOS=equipe-clinica@exemplo.local,plantao@exemplo.local
EMAIL_INTERVALO_MINIMO_S=600

# Usado apenas nos modos local e smtp. Nunca coloque credenciais reais em arquivos versionados.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PORTA=587
SMTP_TLS=1
SMTP_USUARIO=
SMTP_SENHA=

# Limites de risco (os mesmos do firmware e do Node-RED)
LIMITE_BPM_MAXIMO=120
LIMITE_BPM_MINIMO=50
LIMITE_TEMP_MAXIMA=38.0
LIMITE_TEMP_MINIMA=35.0
LIMITE_SEM_MOVIMENTO_S=600
LIMITE_SEM_DADOS_S=300

# Armazenamento
API_CAPACIDADE_POR_PACIENTE=5000
API_GRAVAR_CSV=1

# Ponte MQTT (opcional; HiveMQ Cloud)
MQTT_USUARIO=
MQTT_SENHA=
