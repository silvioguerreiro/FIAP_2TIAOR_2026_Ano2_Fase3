  {
    "id": "fn_limites",
    "type": "function",
    "z": "cardioia_f3_tab",
    "name": "Definir limites de alerta",
    "func": "// Limites de alerta definidos pelo grupo (camada Fog). Justificativa no relatorio da Parte 2.\n// Ausencia de movimento: 600 s (10 min) em producao. O dispositivo (Edge) usa 60 s no modo\n// de demonstracao e informa o alerta pela mascara; o Fog aceita os dois.\nconst limites = {\n    bpmMax: 120,       // acima: taquicardia\n    bpmMin: 50,        // abaixo (com bpm > 0): bradicardia\n    tempMax: 38.0,     // acima: febre\n    tempMin: 35.0,     // abaixo: hipotermia\n    semMovimentoS: 600 // segundos sem movimento\n};\nflow.set('limites', limites);\nflow.set('historico', []);\nflow.set('alertasAtivos', []);\nnode.status({ fill: 'blue', shape: 'ring', text: 'limites definidos' });\nmsg.payload = limites;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 460,
    "wires": [
      [
        "dbg_limites"
      ]
    ]
  },
  {
    "id": "dbg_limites",
    "type": "debug",
    "z": "cardioia_f3_tab",
    "name": "debug limites",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 720,
    "y": 460,
    "wires": []
  },
  {
    "id": "fn_normalizar",
    "type": "function",
    "z": "cardioia_f3_tab",
    "name": "Normalizar amostra",
    "func": "// Normaliza a amostra publicada pelo ESP32 em <prefixo>/sinais e distribui\n// para graficos, medidores, tabela e avaliacao de limites.\n// Saidas: 1 grafico bpm | 2 grafico temperatura | 3 medidor temp | 4 medidor umidade | 5 medidor bpm | 6 tabela | 7 avaliacao\nconst p = msg.payload;\nif (!p || typeof p !== 'object') { node.warn('payload invalido: ' + JSON.stringify(msg.payload)); return null; }\nconst agoraMs = Date.now();\n// Carimbo de tempo do dispositivo (epoca Unix via NTP). Se for relativo (sem NTP), usa a hora de chegada.\nconst tsMs = (typeof p.ts === 'number' && !p.tsrel && p.ts > 1700000000) ? p.ts * 1000 : agoraMs;\nconst amostra = {\n    disp: p.disp || 'desconhecido',\n    seq: Number(p.seq) || 0,\n    ts: tsMs,\n    tsrel: !!p.tsrel,\n    temp: Number(p.temp),\n    umid: Number(p.umid),\n    bpm: Number(p.bpm) || 0,\n    mov: Number(p.mov) === 1,\n    mascara: Number(p.alertas) || 0,\n    origem: p.origem || 'rt',\n    recebidoEm: agoraMs\n};\nflow.set('ultimaAmostra', amostra);\nnode.status({ fill: amostra.origem === 'sync' ? 'yellow' : 'green', shape: 'dot', text: 'seq ' + amostra.seq + ' (' + amostra.origem + ') bpm ' + amostra.bpm + ' temp ' + amostra.temp.toFixed(1) });\n\n// Historico das ultimas 12 amostras para a tabela (mais recente primeiro)\nconst hist = flow.get('historico') || [];\nhist.unshift({\n    hora: new Date(tsMs).toLocaleTimeString('pt-BR'),\n    seq: amostra.seq,\n    bpm: amostra.bpm,\n    temp_c: amostra.temp.toFixed(1),\n    umid_pct: amostra.umid.toFixed(0),\n    movimento: amostra.mov ? 'sim' : 'nao',\n    alertas_disp: amostra.mascara,\n    origem: amostra.origem\n});\nwhile (hist.length > 12) hist.pop();\nflow.set('historico', hist);\n\nconst mBpm   = { payload: amostra.bpm,  topic: 'Frequencia cardiaca', timestamp: tsMs };\nconst mTemp  = { payload: amostra.temp, topic: 'Temperatura', timestamp: tsMs };\nconst mGTemp = { payload: amostra.temp };\nconst mGUmid = { payload: amostra.umid };\nconst mGBpm  = { payload: amostra.bpm };\nconst mTab   = { payload: hist };\nconst mAval  = { payload: amostra };\nreturn [mBpm, mTemp, mGTemp, mGUmid, mGBpm, mTab, mAval];\n",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 240,
    "wires": [
      [
        "ui_chart_bpm"
      ],
      [
        "ui_chart_temp"
      ],
      [
        "ui_gauge_temp"
      ],
      [
        "ui_gauge_umid"
      ],
      [
        "ui_gauge_bpm"
      ],
