        "fn_avaliar"
      ]
    ]
  },
  {
    "id": "fn_avaliar",
    "type": "function",
    "z": "cardioia_f3_tab",
    "name": "Avaliar limites (Fog)",
    "func": "// Avaliacao dos limites na camada Fog (Node-RED) combinada com a avaliacao feita\n// no dispositivo (Edge, bitmask em \"alertas\"). Saidas: 1 painel | 2 notificacao | 3 texto\nconst LIM = flow.get('limites') || { bpmMax: 120, bpmMin: 50, tempMax: 38.0, tempMin: 35.0, semMovimentoS: 600 };\nconst a = msg.payload;\nconst tipos = [];\nif (a.bpm > LIM.bpmMax) tipos.push('taquicardia');\nif (a.bpm > 0 && a.bpm < LIM.bpmMin) tipos.push('bradicardia');\nif (!isNaN(a.temp) && a.temp > LIM.tempMax) tipos.push('febre');\nif (!isNaN(a.temp) && a.temp < LIM.tempMin) tipos.push('hipotermia');\n\n// Ausencia de movimento avaliada no Fog pelo instante do ultimo movimento recebido\nlet ultimoMov = flow.get('ultimoMovimentoMs') || 0;\nif (a.mov) { ultimoMov = a.ts; flow.set('ultimoMovimentoMs', ultimoMov); }\nif (ultimoMov && (a.ts - ultimoMov) > LIM.semMovimentoS * 1000) tipos.push('sem_movimento');\n\n// Alertas ja avaliados no dispositivo (bits: 1 taquicardia, 2 bradicardia, 4 febre, 8 hipotermia, 16 sem_movimento)\nconst nomes = ['taquicardia', 'bradicardia', 'febre', 'hipotermia', 'sem_movimento'];\nnomes.forEach((n, i) => { if ((a.mascara & (1 << i)) && !tipos.includes(n)) tipos.push(n); });\n\nconst ativo = tipos.length > 0;\nconst hora = new Date(a.ts).toLocaleTimeString('pt-BR');\nconst resumo = 'bpm ' + a.bpm + ' | ' + a.temp.toFixed(1) + ' C | umid ' + a.umid.toFixed(0) + '% | mov ' + (a.mov ? 'sim' : 'nao');\nconst texto = ativo ? (tipos.join(', ') + ' | ' + resumo) : resumo;\nconst cor = ativo ? '#c62828' : '#2e7d32';\nnode.status({ fill: ativo ? 'red' : 'green', shape: 'dot', text: ativo ? tipos.join(', ') : 'normal' });\n\nconst painel = { payload: { ativo, texto, cor, tipos, hora, origem: a.origem, seq: a.seq } };\n\n// Notificacao apenas quando surge um tipo novo de alerta em tempo real (evita repetir a cada 5 s)\nconst anteriores = flow.get('alertasAtivos') || [];\nconst novos = tipos.filter(t => !anteriores.includes(t));\nflow.set('alertasAtivos', tipos);\nlet notif = null;\nif (novos.length && a.origem === 'rt') {\n    notif = { payload: 'Paciente 01: ' + novos.join(', ') + ' (bpm ' + a.bpm + ', ' + a.temp.toFixed(1) + ' C) as ' + hora };\n}\nconst txt = { payload: ativo ? (hora + ': ' + tipos.join(', ')) : 'nenhum alerta ativo (' + hora + ')' };\nreturn [painel, notif, txt];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 740,
    "y": 580,
    "wires": [
      [
        "ui_painel_alerta"
      ],
      [
        "ui_notificacao"
      ],
      [
        "ui_texto_alerta"
      ]
    ]
  },
  {
    "id": "fn_estado",
    "type": "function",
    "z": "cardioia_f3_tab",
    "name": "Estado do dispositivo",
    "func": "// Estado do dispositivo publicado em <prefixo>/estado (mensagem retida) e testamento (LWT).\nconst e = msg.payload || {};\nconst estado = String(e.estado || 'desconhecido');\nconst cores = { online: '#2e7d32', sincronizando: '#f9a825', offline: '#757575', offline_inesperado: '#c62828' };\nconst hora = e.ts ? new Date(e.ts * 1000).toLocaleTimeString('pt-BR') : new Date().toLocaleTimeString('pt-BR');\nlet texto = estado.toUpperCase() + ' | ' + hora;\nif (e.pendentes !== undefined) texto += ' | pendentes ' + e.pendentes + '/' + e.capacidade;\nif (e.publicadas !== undefined) texto += ' | publicadas ' + e.publicadas;\nif (e.descartadas !== undefined) texto += ' | descartadas ' + e.descartadas;\nif (e.rssi !== undefined) texto += ' | RSSI ' + e.rssi + ' dBm';\nif (e.heap !== undefined) texto += ' | heap livre ' + Math.round(e.heap / 1024) + ' KB';\nflow.set('estadoDispositivo', estado);\nnode.status({ fill: estado === 'online' ? 'green' : (estado === 'sincronizando' ? 'yellow' : 'red'), shape: 'dot', text: estado });\nreturn { payload: { estado, texto, cor: cores[estado] || '#757575', disp: e.disp || '' } };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 820,
    "wires": [
      [
        "ui_painel_estado"
      ]
    ]
  },
  {
    "id": "fn_alerta_disp",
    "type": "function",
    "z": "cardioia_f3_tab",
    "name": "Alerta publicado pelo dispositivo",
    "func": "// Ultimo estado de alerta publicado pelo proprio dispositivo (retido em <prefixo>/alertas).\nconst p = msg.payload || {};\nconst hora = p.ts ? new Date(p.ts * 1000).toLocaleTimeString('pt-BR') : '';\nif (p.ativo) {\n    msg.payload = hora + ': ' + (p.tipos || '').split(',').join(', ') + ' (bpm ' + p.bpm + ', ' + Number(p.temp).toFixed(1) + ' C, seq ' + p.seq + ')';\n} else {\n    msg.payload = 'sem alerta no dispositivo' + (hora ? ' (' + hora + ')' : '');\n}\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 700,
    "wires": [
      [
        "ui_texto_alerta_disp"
      ]
    ]
  },
